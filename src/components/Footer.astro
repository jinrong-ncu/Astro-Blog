---
import { Github, Mail, Rss } from "lucide-react";
import { AUTHOR_EMAIL, AUTHOR_GITHUB, AUTHOR_NAME } from "../consts";
const year = new Date().getFullYear();
---

<footer class="relative z-10 mx-auto mb-8 w-[calc(100%-3rem)] max-w-5xl">
  <div class="flex flex-col gap-5 rounded-3xl border border-zinc-200/80 bg-white/55 px-6 py-6 backdrop-blur-2xl dark:border-white/10 dark:bg-zinc-950/50 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-extrabold text-zinc-900 dark:text-white">{AUTHOR_NAME}的实用教程</p>
      <p class="mt-1 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">先解决问题，再解释原理。涉及资格、价格和地区时优先核对官方资料。</p>
      <p class="mt-2 text-xs text-zinc-400">© {year} {AUTHOR_NAME}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/about/" class="rounded-full px-3 py-2 text-sm font-bold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-white/10">关于</a>
      <a href="/projects/" class="rounded-full px-3 py-2 text-sm font-bold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-white/10">项目</a>
      <a href="/uses/" class="rounded-full px-3 py-2 text-sm font-bold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-white/10">工作流</a>
      <a href={`https://github.com/${AUTHOR_GITHUB}`} target="_blank" rel="noreferrer" aria-label="GitHub" class="rounded-full p-2 text-zinc-500 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-white/10"><Github className="h-4 w-4" /></a>
      <a href="/rss.xml" aria-label="RSS" class="rounded-full p-2 text-zinc-500 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-white/10"><Rss className="h-4 w-4" /></a>
      <a href={`mailto:${AUTHOR_EMAIL}`} aria-label="Email" class="rounded-full p-2 text-zinc-500 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-white/10"><Mail className="h-4 w-4" /></a>
    </div>
  </div>
</footer>
