---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight, BookOpen, LayoutPanelTop, Search, UploadCloud } from "lucide-react";
import { AUTHOR_NAME } from "../consts";
import "../styles/global.css";

const projects = [
  {
    name: "实用教程内容系统",
    description: "当前站点本身：Astro Content Collections、分类与标签、RSS、sitemap、OG 图片、JSON-LD、Pagefind 搜索和旧 URL 跳转。",
    href: "/",
    icon: BookOpen,
    status: "持续维护",
  },
  {
    name: "多文件上传队列",
    description: "只在浏览器内模拟的 React 演示，用来验证有限并发、逐项取消和全部取消。不会把选中的文件发送到服务器。",
    href: "/demos/upload/",
    icon: UploadCloud,
    status: "可交互",
  },
  {
    name: "Apple 风格界面实验",
    description: "几组独立的导航与材质实验，用于观察动效、层级和触控反馈，不伪装成真实 App 或官方界面。",
    href: "/demos/apple-tabs/",
    icon: LayoutPanelTop,
    status: "界面实验",
  },
  {
    name: "搜索可发现性",
    description: "围绕构建产物、canonical、结构化数据、sitemap 与 Search Console 的公开检查流程。",
    href: "/blog/astro-blog-seo-checklist/",
    icon: Search,
    status: "文档化",
  },
];
---

<Layout title={`项目 - ${AUTHOR_NAME}`} description="这个博客中真实存在、可访问或已文档化的项目与交互实验。">
  <section class="animate-fade-in">
    <p class="text-sm font-bold text-blue-600 dark:text-blue-300">Projects</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">真实存在的站点项目</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">这里只列当前仓库里能打开、能检查或有明确文档的内容。未开始的想法不会被包装成项目。</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map((project) => (
        <a href={project.href} class="group rounded-2xl border border-zinc-200/80 bg-white/60 p-6 transition hover:-translate-y-1 hover:border-zinc-300 dark:border-white/10 dark:bg-zinc-950/50 dark:hover:border-white/20">
          <div class="flex items-start justify-between gap-4">
            <project.icon className="h-6 w-6 text-blue-600 dark:text-blue-300" />
            <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">{project.status}</span>
          </div>
          <h2 class="mt-5 text-xl font-extrabold text-zinc-950 dark:text-white">{project.name}</h2>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{project.description}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-blue-600 dark:text-blue-300">打开 <ArrowUpRight className="h-4 w-4" /></span>
        </a>
      ))}
    </div>
  </section>
</Layout>
