---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { BLOG_CATEGORIES, CATEGORY_META } from "../../content/categories";
import { AUTHOR_NAME } from "../../consts";
import "../../styles/global.css";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const categories = BLOG_CATEGORIES.map((id) => ({
  id,
  ...CATEGORY_META[id],
  posts: posts
    .filter((post) => post.data.category === id)
    .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()),
})).filter((category) => category.posts.length > 0);
---

<Layout title={`分类 - ${AUTHOR_NAME}`} description="按读者要解决的问题浏览实用教程。">
  <section>
    <p class="text-sm font-bold text-blue-600 dark:text-blue-300">Categories</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">按问题类型浏览</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">分类表示你正在解决哪类问题；产品和技术名称留给标签。</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {categories.map((category) => (
        <a href={`/categories/${category.id}/`} class="rounded-2xl border border-zinc-200/80 bg-white/60 p-6 transition hover:-translate-y-1 hover:border-zinc-300 dark:border-white/10 dark:bg-zinc-950/50 dark:hover:border-white/20">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-xl font-extrabold text-zinc-950 dark:text-white">{category.label}</h2>
            <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">{category.posts.length}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{category.description}</p>
          <p class="mt-5 text-xs font-semibold text-zinc-400">最近：{category.posts[0].data.title}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
