---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight, Github, Mail, Rss } from "lucide-react";
import { AUTHOR_EMAIL, AUTHOR_GITHUB, AUTHOR_NAME, AUTHOR_ZHIHU } from "../consts";
import "../styles/global.css";

const sections = [
  {
    title: "写什么",
    text: "学生权益、AI 工具、Mac 与 iPhone、个人网站、文件安全与出境服务。每篇文章都围绕一个具体任务或故障。",
  },
  {
    title: "怎么核对",
    text: "版本、价格、资格、地区与政策优先引用官方资料；仓库能验证的实现以代码和构建结果为准；没有实测就明确写成文档整理。",
  },
  {
    title: "怎么更新",
    text: "有实质变化时记录更新时间。重复文章会合并并保留跳转，过期、无证据或只有测试用途的内容会直接下线。",
  },
];

const links = [
  { label: "GitHub", href: `https://github.com/${AUTHOR_GITHUB}`, icon: Github },
  { label: "知乎", href: `https://www.zhihu.com/people/${AUTHOR_ZHIHU}`, icon: ArrowUpRight },
  { label: "邮件", href: `mailto:${AUTHOR_EMAIL}`, icon: Mail },
  { label: "RSS", href: "/rss.xml", icon: Rss },
];
---

<Layout
  title={`关于 - ${AUTHOR_NAME}`}
  description="关于 Ronin.XI 与本站的选题范围、核对方法、更新原则和联系方式。"
>
  <div class="animate-fade-in space-y-14">
    <section class="grid gap-8 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:items-center">
      <img src="/about.jpg" alt={`${AUTHOR_NAME}的个人照片`} class="aspect-[4/5] w-full rounded-3xl border border-zinc-200/80 object-cover dark:border-white/10" />
      <div>
        <p class="text-sm font-bold text-blue-600 dark:text-blue-300">About</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">你好，我是{AUTHOR_NAME}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
          我维护这个实用教程站。这里不再收集零散知识点，也不把没验证过的体验写成结论；目标是让读者能完成一个任务、看懂失败原因，并知道如何恢复。
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          {links.map(({ label, href, icon: Icon }) => (
            <a href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noreferrer" : undefined} class="inline-flex items-center gap-2 rounded-full border border-zinc-300/80 bg-white/60 px-4 py-2 text-sm font-bold text-zinc-700 transition hover:border-zinc-500 dark:border-white/15 dark:bg-zinc-900/60 dark:text-zinc-200">
              <Icon className="h-4 w-4" />
              {label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-extrabold text-zinc-950 dark:text-white">本站的编辑原则</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {sections.map((section) => (
          <article class="rounded-2xl border border-zinc-200/80 bg-white/60 p-6 dark:border-white/10 dark:bg-zinc-950/50">
            <h3 class="font-extrabold text-zinc-950 dark:text-white">{section.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{section.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rounded-3xl border border-zinc-200/80 bg-white/60 p-6 dark:border-white/10 dark:bg-zinc-950/50 sm:p-8">
      <h2 class="text-2xl font-extrabold text-zinc-950 dark:text-white">从哪里开始</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">按问题类型浏览最省时间；想追踪变化，可以使用归档或 RSS。站点实现与可交互实验放在项目页。</p>
      <div class="mt-6 flex flex-wrap gap-4 text-sm font-bold text-blue-600 dark:text-blue-300">
        <a href="/categories/">浏览分类 →</a>
        <a href="/archive/">文章归档 →</a>
        <a href="/projects/">查看项目 →</a>
        <a href="/uses/">工具与工作流 →</a>
      </div>
    </section>
  </div>
</Layout>
