---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { BLOG_CATEGORIES, CATEGORY_META } from "../content/categories";
import { AUTHOR_NAME } from "../consts";
import "../styles/global.css";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      (b.data.updatedDate ?? b.data.pubDate).valueOf() -
      (a.data.updatedDate ?? a.data.pubDate).valueOf(),
  );
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 9);
const categories = BLOG_CATEGORIES.map((id) => ({
  id,
  ...CATEGORY_META[id],
  count: posts.filter((post) => post.data.category === id).length,
})).filter((category) => category.count > 0);
---

<Layout
  title={`${AUTHOR_NAME}的实用教程`}
  description="面向学生与独立开发者的实用教程：学生权益、AI 工具、Mac 与 iPhone、建站 SEO、文件安全和出境服务。"
>
  <div class="animate-fade-in space-y-16">
    <section class="max-w-3xl pb-2 pt-6 sm:pt-10">
      <p class="text-sm font-bold tracking-wide text-blue-600 dark:text-blue-300">先解决问题，再解释原理</p>
      <h1 class="mt-4 text-balance text-4xl font-extrabold leading-tight tracking-tight text-zinc-950 dark:text-white sm:text-6xl">
        能跟着做、能检查结果的实用教程
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        聚焦学生权益、AI 工具、Apple 设备、个人网站、文件安全和出境服务。涉及价格、资格、版本与地区的内容，优先依据官方资料并注明更新时间。
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#latest" class="rounded-full bg-zinc-950 px-5 py-2.5 text-sm font-bold text-white dark:bg-white dark:text-zinc-950">查看最新教程</a>
        <a href="/categories/" class="rounded-full border border-zinc-300/80 bg-white/60 px-5 py-2.5 text-sm font-bold text-zinc-700 dark:border-white/15 dark:bg-zinc-900/60 dark:text-zinc-200">按分类浏览</a>
      </div>
    </section>

    {featuredPost && (
      <section>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.14em] text-zinc-400">推荐入口</p>
        <a href={`/blog/${featuredPost.id}/`} class="group block rounded-3xl border border-zinc-200/80 bg-white/65 p-6 backdrop-blur-2xl transition hover:-translate-y-1 hover:border-zinc-300 dark:border-white/10 dark:bg-zinc-950/55 dark:hover:border-white/20 sm:p-8">
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
            <span class="rounded-full bg-blue-600 px-3 py-1 text-white">精选</span>
            <span class="text-zinc-500 dark:text-zinc-400">{CATEGORY_META[featuredPost.data.category].label}</span>
          </div>
          <h2 class="mt-5 max-w-3xl text-2xl font-extrabold tracking-tight text-zinc-950 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300 sm:text-4xl">{featuredPost.data.title}</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-zinc-600 dark:text-zinc-400">{featuredPost.data.description}</p>
        </a>
      </section>
    )}

    <section>
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-zinc-400">Topics</p>
          <h2 class="mt-2 text-2xl font-extrabold text-zinc-950 dark:text-white">按问题类型浏览</h2>
        </div>
        <a href="/categories/" class="text-sm font-bold text-blue-600 dark:text-blue-300">全部分类 →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => (
          <a href={`/categories/${category.id}/`} class="rounded-2xl border border-zinc-200/80 bg-white/55 p-5 transition hover:border-zinc-300 hover:bg-white/80 dark:border-white/10 dark:bg-zinc-950/50 dark:hover:border-white/20 dark:hover:bg-zinc-900/70">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-extrabold text-zinc-950 dark:text-white">{category.label}</h3>
              <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">{category.count}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{category.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="latest">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-zinc-400">Latest</p>
          <h2 class="mt-2 text-2xl font-extrabold text-zinc-950 dark:text-white">最近更新</h2>
        </div>
        <a href="/archive/" class="text-sm font-bold text-blue-600 dark:text-blue-300">查看归档 →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</Layout>
