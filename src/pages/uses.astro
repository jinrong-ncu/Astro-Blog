---
import Layout from "../layouts/Layout.astro";
import { BookOpen, Code2, GitBranch, Search } from "lucide-react";
import { AUTHOR_NAME } from "../consts";
import "../styles/global.css";

const workflows = [
  {
    title: "内容与数据",
    icon: BookOpen,
    items: ["Markdown 写正文", "Astro Content Collections 校验 frontmatter", "分类负责问题类型，标签负责产品与技术", "updatedDate 只记录实质核对"],
  },
  {
    title: "界面与交互",
    icon: Code2,
    items: ["Astro 默认静态输出", "UnoCSS 管理样式", "React 只用于搜索、主题和交互演示", "不为装饰增加运行时依赖"],
  },
  {
    title: "发现与订阅",
    icon: Search,
    items: ["Pagefind 生成站内搜索索引", "RSS 提供订阅", "sitemap 与 canonical 统一首选 URL", "BlogPosting JSON-LD 反映发布日期与更新时间"],
  },
  {
    title: "维护与验证",
    icon: GitBranch,
    items: ["Git 记录内容与代码变更", "官方资料核对资格、价格和地区", "生产构建验证路由与内容集合", "合并文章时保留永久跳转"],
  },
];
---

<Layout title={`工具与工作流 - ${AUTHOR_NAME}`} description="本站实际使用的内容、前端、搜索和维护工作流。">
  <section class="animate-fade-in">
    <p class="text-sm font-bold text-blue-600 dark:text-blue-300">Uses</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">这个站点如何工作</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">这不是一份未经核实的设备与软件购物清单，只记录当前仓库真实采用的工具和编辑流程。</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {workflows.map((workflow) => (
        <section class="rounded-2xl border border-zinc-200/80 bg-white/60 p-6 dark:border-white/10 dark:bg-zinc-950/50">
          <div class="flex items-center gap-3">
            <workflow.icon className="h-5 w-5 text-blue-600 dark:text-blue-300" />
            <h2 class="text-xl font-extrabold text-zinc-950 dark:text-white">{workflow.title}</h2>
          </div>
          <ul class="mt-5 space-y-3">
            {workflow.items.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-400"></span>{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Layout>
