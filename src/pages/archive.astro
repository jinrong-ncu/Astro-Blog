---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { CATEGORY_META } from "../content/categories";
import { AUTHOR_NAME } from "../consts";
import "../styles/global.css";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const groups = Object.entries(Object.groupBy(posts, (post) => String((post.data.updatedDate ?? post.data.pubDate).getFullYear())))
  .sort(([a], [b]) => Number(b) - Number(a));
---

<Layout title={`文章归档 - ${AUTHOR_NAME}`} description="按最近核对或发布日期浏览全部实用教程。">
  <section>
    <p class="text-sm font-bold text-blue-600 dark:text-blue-300">Archive</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">文章归档</h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">共 {posts.length} 篇公开文章，按最近核对时间排列。</p>
    <div class="mt-10 space-y-12">
      {groups.map(([year, yearPosts]) => (
        <section>
          <h2 class="text-2xl font-extrabold text-zinc-950 dark:text-white">{year}</h2>
          <div class="mt-5 divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-white/10 dark:border-white/10">
            {yearPosts?.map((post) => {
              const date = post.data.updatedDate ?? post.data.pubDate;
              return (
                <a href={`/blog/${post.id}/`} class="grid gap-2 py-4 transition hover:pl-2 sm:grid-cols-[7rem_8rem_1fr] sm:items-center">
                  <time datetime={date.toISOString()} class="text-sm text-zinc-400">{date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}</time>
                  <span class="text-xs font-bold text-blue-600 dark:text-blue-300">{CATEGORY_META[post.data.category].label}</span>
                  <span class="font-bold text-zinc-800 dark:text-zinc-100">{post.data.title}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>
